{
  "profile": "br-json/1",
  "description": "BR-JSON v1 golden vectors (ADR-0014; BRT-02-SIGNATURES-AND-HASHING §2.2a, §3.2). Protocol surface: changing an expectation requires a new profile version.",
  "hashConstruction": "contentHash = 'sha256:' + hex(SHA-256('BR' || 0x01 || domainTag || 0x00 || schemaId '@' version || 0x00 || 'br-json/1' || 0x00 || UTF8(JCS(normalized))))",
  "equalHashGroups": [
    ["uuid-minimal", "absent-member", "empty-optional-array-pruned", "default-false-pruned"],
    ["order-a", "order-b"],
    ["unicode-composed", "unicode-decomposed"],
    ["set-array-1", "set-array-2"],
    ["decimal-1", "decimal-1.0", "decimal-1.00"],
    ["decimal-negative-zero", "decimal-negative-zero-fraction"],
    ["timestamp-offset", "timestamp-zero-submillis"]
  ],
  "distinctHashGroups": [
    ["ordered-array-1", "ordered-array-2"],
    ["uuid-minimal", "domain-tag-a", "domain-tag-b", "schema-version-2"],
    ["default-false-pruned", "default-true-kept"]
  ],
  "schemas": [
