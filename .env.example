# Local development only. Never commit real credentials.
# Superuser/admin connection used ONLY by `pnpm db:bootstrap` (creates roles, grants).
BR_ADMIN_DATABASE_URL=postgres://br_admin:br_admin_dev_only@localhost:55432/bragging_rights
# Migration owner (DDL). Never used by running applications.
BR_OWNER_DATABASE_URL=postgres://br_owner:br_owner_dev_only@localhost:55432/bragging_rights
# API login: may SET ROLE br_authority | br_results | br_identity | br_organizations | br_public_read
# only (NOINHERIT, no privileges by itself). It can never reach identity_private.
BR_API_DATABASE_URL=postgres://br_api:br_api_dev_only@localhost:55432/bragging_rights
# PII vault login (BRT-04): may SET ROLE br_identity_private only. Nothing else can read the vault.
BR_VAULT_DATABASE_URL=postgres://br_api_vault:br_api_vault_dev_only@localhost:55432/bragging_rights
# BRT-05R · Operator login: may SET ROLE br_catalog only (INTERNAL sport-catalog mutation).
# Opt-in for the API: only when this is set does the API enable catalog mutation (otherwise the
# INTERNAL catalog endpoints answer 503; public catalog reads and competition flows still work).
# Seeds/demos use the local development login when unset. Production never uses a dev default.
BR_OPERATOR_DATABASE_URL=postgres://br_operator_app:br_operator_app_dev_only@localhost:55432/bragging_rights
# Worker login: may SET ROLE br_worker only.
BR_WORKER_DATABASE_URL=postgres://br_worker_app:br_worker_app_dev_only@localhost:55432/bragging_rights
# Maintenance login: may SET ROLE br_rebuild only (projection rebuilds; operators only).
BR_MAINTENANCE_DATABASE_URL=postgres://br_maintenance:br_maintenance_dev_only@localhost:55432/bragging_rights
# Test database (same cluster, separate database)
BR_TEST_DATABASE_NAME=bragging_rights_test

# ── BRT-04 development-only settings (all refused when NODE_ENV=production) ──
# There are NO built-in secrets. Generate your own values locally; never commit them.
# Development PII cipher key material (≥ 32 chars; AES-256-GCM key = SHA-256 of it). NOT a KMS.
# Required by `pnpm db:seed:identity` and for the API's private-data endpoints (without it they
# answer 503). Generate: openssl rand -hex 32
BR_VAULT_DEV_KEY=
# Development bearer tokens (HMAC). Enabled only with BR_DEV_AUTH=1 outside production; then
# BR_DEV_AUTH_SECRET is mandatory (≥ 32 random chars), or the API refuses to start.
# Generate: openssl rand -hex 32 · Mint a token: pnpm --filter @br/api dev-token <subject> [--operator]
BR_DEV_AUTH=0
BR_DEV_AUTH_SECRET=
# Web → API base URL (server-side fetches).
BR_API_URL=http://127.0.0.1:4000
