# STG-01A · Staging environment template. Names and placeholders only — never commit values.
#
#   cp deploy/staging/.env.example deploy/staging/.env && chmod 600 deploy/staging/.env
#
# Fill every value on the staging VM, then run deploy/staging/preflight.sh. It refuses placeholders,
# development or production markers, and passwords that are short or not URL-safe.
# Generate each password with:  openssl rand -hex 32
# Never reuse a value from any other environment. Production credentials must never appear here.

# Image tag: the git commit being deployed (e.g. the output of `git rev-parse --short=12 HEAD`).
STAGING_IMAGE_TAG=__REPLACE__

# Public staging hostname (DNS A/AAAA record → this VM). Never the marketing domain.
STAGING_DOMAIN=__REPLACE__
# Contact address for the Let's Encrypt account (expiry notices).
ACME_EMAIL=__REPLACE__

# Supabase STAGING project (Auth only): https://<project-ref>.supabase.co and its publishable
# (anon) key. Never the service-role key, never the production project.
STAGING_SUPABASE_URL=__REPLACE__
STAGING_SUPABASE_ANON_KEY=__REPLACE__

# PostgreSQL superuser (br_admin), used only by the postgres container and the ops bootstrap.
BR_ADMIN_PASSWORD=__REPLACE__

# One password per database login (bootstrap sets them; the services connect with them).
BR_OWNER_PASSWORD=__REPLACE__
BR_API_PASSWORD=__REPLACE__
BR_VAULT_PASSWORD=__REPLACE__
BR_WORKER_PASSWORD=__REPLACE__
BR_MAINTENANCE_PASSWORD=__REPLACE__
BR_OPERATOR_PASSWORD=__REPLACE__
BR_VERIFICATION_OPERATOR_PASSWORD=__REPLACE__
BR_ACHIEVEMENT_OPERATOR_PASSWORD=__REPLACE__
BR_ACHIEVEMENT_WORKER_PASSWORD=__REPLACE__
BR_RECORD_OPERATOR_PASSWORD=__REPLACE__
BR_RECORD_WORKER_PASSWORD=__REPLACE__
BR_RANKING_OPERATOR_PASSWORD=__REPLACE__
BR_RANKING_WORKER_PASSWORD=__REPLACE__

# Filled later, during platform setup (may stay empty until then):
# the operator's platform account id (after the operator's first sign-in), for catalog provisioning.
BR_CATALOG_OPERATOR_ACCOUNT_ID=
# the platformPrincipalId printed by `authority:results bootstrap-anchor`.
BR_PLATFORM_PRINCIPAL_ID=
